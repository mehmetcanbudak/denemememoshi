<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Memoshi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>MemoshiDeviceIdentityAccessGroup</key>
	<string>$(DEVELOPMENT_TEAM).com.mehmetcanbudak.memoshi.devices</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan another Memoshi device's one-time pairing code.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Read and update your Apple Reminders in Memoshi when you choose to connect them.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Read and update your Apple Reminders in Memoshi when you choose to connect them.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Read your Apple Calendar events in Memoshi when you choose to connect them.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Read your Apple Calendar events in Memoshi when you choose to connect them.</string>
	<key>NSContactsUsageDescription</key>
	<string>Read your Apple Contacts in Memoshi when you choose to connect them.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Find and connect to the Memoshi device you explicitly choose to pair.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_memoshi._tcp</string>
	</array>
</dict>
</plist>
